        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(moongame_security_sampled_total + moongame_security_failed_total + moongame_security_journal_dropped_total + moongame_security_journal_failed_total) and on (instance, environment) (time() - moongame_security_sample_timestamp_seconds < 45)",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{rule}} {{event}} {{instance}}"
