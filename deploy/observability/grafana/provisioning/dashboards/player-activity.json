      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "description": "Суточные агрегаты за последние 30 дней UTC. Текущий день неполный; до начала сбора данных нет. При удалении аккаунта его строки исключаются из пересчёта.",
      "targets": [
        {
          "refId": "A",
          "expr": "moongame_player_activity_daily_players and on(job,instance) ((moongame_source_up{source=\"activity\"} == 1) and on(job,instance) (time() - moongame_player_activity_sample_timestamp_seconds < 45))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Игроки"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "fixed",
            "fixedColor": "cyan"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "day",
        "orientation": "vertical",
        "showValue": "auto",
        "barWidth": 0.85,
        "groupWidth": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": -45
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "day",
                "Value"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "Уникальные игроки по дням"
