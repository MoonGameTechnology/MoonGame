# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# Playtest capture (per-run JSONL from the prototype dev server — M0)
playtest-logs/
# ECON playtest harness output (regenerated by prototype/econplaytest.mjs)
prototype/econ-playtest-result.json

# VPS server config — holds a token; never commit (see deploy/server.env.example)
deploy/server.env
# Rollback point written by deploy/update.sh on the prod host (runtime state, not code)
.last-good-image

# Env / secrets (never commit — see docs/architecture.md A04)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Tooling caches
.turbo/
.eslintcache

# MCP browser session output (snapshots / console logs / traces)
.playwright-mcp/
# Скриншоты браузерной проверки: инструмент кладёт их в КОРЕНЬ репозитория, и
# `git add -A` уносит их в коммит (так в main уехали три штуки на 440 КБ).
# Картинки проекта живут в docs/ и prototype/ — в корне их не бывает.
/*.png
