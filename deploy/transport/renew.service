[Unit]
Description=Renew MoonGame internal transport certificates
After=moongame-docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/moongame-ops/deploy/transport/renew.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/moongame-transport /var/lib/moongame
