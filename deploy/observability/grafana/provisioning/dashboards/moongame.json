    {
      "id": 5,
      "title": "Подключения игроков",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(moongame_connections) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 6,
      "title": "Действия в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(outcome) (rate(moongame_actions_total[2m]))) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": false,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 7,
      "title": "CPU всего VPS, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - sum(rate(moongame_host_cpu_seconds_total{mode=\"idle\"}[2m])) / sum(rate(moongame_host_cpu_seconds_total[2m])))) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": false,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 8,
      "title": "Доступная RAM VPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
