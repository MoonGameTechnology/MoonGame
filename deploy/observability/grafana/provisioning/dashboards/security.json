    {
      "id": 11,
      "title": "Правила Prometheus в состоянии firing",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=~\"MoonGameSecurity.*\",alertstate=\"firing\"}",
