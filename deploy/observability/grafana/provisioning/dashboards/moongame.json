    {
      "id": 13,
      "title": "Версия сервера",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "moongame_build_info and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.version}"
        },
        "overrides": []
      },
      "options": {
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 99,
      "type": "text",
      "title": "Границы первого запуска",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Локальный мониторинг на игровом VPS. При отказе всего VPS пульт также недоступен. Внешние уведомления и бэкапы не настроены. CPU/RAM относятся ко всему VPS. Логи, персональные данные, состояния отдельных матчей и p95 здесь не собираются. Данные старше 45 секунд скрываются из игровых панелей; проверьте свежесть и источники."
      }
    }
  ]
}
