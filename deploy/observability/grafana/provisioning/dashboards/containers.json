    {
      "id": 16,
      "title": "Ограничение CPU, секунд в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(moongame_container_cpu_throttled_seconds_total[2m]) and on(container) (moongame_container_resources_up == 1) and on() (time() - moongame_container_sample_timestamp_seconds < 45)",
          "instant": false,
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Последняя остановка из-за OOM",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "description": "Docker State.OOMKilled: причина последней остановки, доступна и для остановленного контейнера; не журнал всех OOM. После следующего запуска флаг может сброситься.",
      "targets": [
        {
          "refId": "A",
          "expr": "moongame_container_oom_killed and on() (time() - moongame_container_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
