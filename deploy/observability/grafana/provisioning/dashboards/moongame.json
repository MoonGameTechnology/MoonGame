        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 10,
      "title": "Ошибки корректности за 5 минут",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(moongame_desyncs_total[5m])) + sum(increase(moongame_dead_letters_total[5m])) + sum(increase(moongame_advance_overflows_total[5m]))) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 11,
      "title": "Обработка приказа: среднее за 5 минут",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(moongame_submit_duration_seconds_sum[5m])) / sum(rate(moongame_submit_duration_seconds_count[5m]))) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": false,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Среднее по измеренным приказам. Это не p95. Без приказов — нет данных."
    },
    {
      "id": 12,
      "title": "Рассылка: среднее за 5 минут",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(moongame_broadcast_duration_seconds_sum[5m])) / sum(rate(moongame_broadcast_duration_seconds_count[5m]))) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": false,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
