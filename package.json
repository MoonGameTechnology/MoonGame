{
  "name": "void-dominion",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Moonwuk Games",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p prototype",
    "prototype": "node prototype/build.mjs",
    "site": "pnpm run prototype && node scripts/stage-site.mjs",
    "dev:server": "node packages/server/dev.mjs",
    "dev:proto-server": "node prototype/netserver.mjs",
    "host": "node prototype/host.mjs",
    "serve": "bash deploy/serve.sh",
    "stack": "docker compose -f deploy/docker-compose.yml up -d --build",
    "doctor": "node prototype/doctor.mjs",
    "perf": "node prototype/perf.mjs",
    "metrics": "node prototype/report.mjs",
    "selfplay": "node prototype/selfplay.mjs",
    "meritscan": "node prototype/meritscan.mjs",
    "rehearsal": "node prototype/rehearsal.mjs",
    "dev:client": "node testclient/build.mjs",
    "mcp:browser": "node scripts/mcp-browser.mjs",
    "smoke:corporation": "pnpm run prototype && node prototype/corptest.mjs",
    "smoke:browser": "node prototype/browsertest.mjs",
    "smoke:browser:install": "node prototype/browsertest.mjs --install",
    "smoke:context": "node prototype/contexttest.mjs",
    "smoke:zoom": "node prototype/zoomtest.mjs",
    "smoke:frontier": "node prototype/frontiertest.mjs",
    "smoke:retreat": "node prototype/retreattest.mjs",
    "smoke:patrol": "node prototype/patroltest.mjs",
    "smoke:relocate": "node prototype/relocatetest.mjs",
    "smoke:radar": "node prototype/radartest.mjs",
    "smoke:vision": "node prototype/visiontest.mjs",
    "smoke:sizes": "node prototype/sizetest.mjs",
    "smoke:startup": "node prototype/startuptest.mjs",
    "smoke:proving-ground": "node prototype/provinggroundtest.mjs",
    "smoke:bootfail": "node prototype/bootfailuretest.mjs",
    "smoke:mobile": "node prototype/mobiletest.mjs",
    "smoke:hotkeys": "node prototype/hotkeystest.mjs",
    "smoke:intro": "node prototype/introtest.mjs",
    "smoke:sector-zero": "node prototype/sectorzerotest.mjs && node prototype/minestest.mjs",
    "smoke:yandex": "node prototype/yandextest.mjs",
    "smoke:net": "node prototype/nettest.mjs",
    "smoke:all": "pnpm run smoke:browser && pnpm run smoke:context && pnpm run smoke:zoom && pnpm run smoke:frontier && pnpm run smoke:retreat && pnpm run smoke:patrol && pnpm run smoke:relocate && pnpm run smoke:startup && pnpm run smoke:proving-ground && pnpm run smoke:bootfail && pnpm run smoke:mobile && pnpm run smoke:hotkeys && pnpm run smoke:intro && pnpm run smoke:sector-zero && pnpm run smoke:yandex && pnpm run smoke:net && pnpm run smoke:sizes && pnpm run smoke:vision",
    "perf:pan": "node prototype/panperf.mjs",
    "ui:shot": "node prototype/uishot.mjs",
    "store:shots": "node prototype/storeshots.mjs",
    "db:psql": "psql \"${DATABASE_URL:-postgres://void:void@127.0.0.1:5432/void}\"",
    "db:schema": "psql \"${DATABASE_URL:-postgres://void:void@127.0.0.1:5432/void}\" -c '\\dt+' -c '\\di'",
    "audit": "pnpm audit --audit-level=high",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run docs-check",
    "docs-check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.83",
    "@types/node": "^26.6.3",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "ws": "8.22.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.8",
      "fast-uri@4": "4.1.5",
      "find-my-way@9": "^9.7.0",
      "brace-expansion": "5.0.12",
      "postcss": "^8.5.25",
      "nanoid@3": "^3.3.18"
    }
  }
}
