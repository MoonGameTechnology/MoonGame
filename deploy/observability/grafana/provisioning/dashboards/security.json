{
  "uid": "moongame-security",
  "title": "MoonGame — безопасность и инциденты",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": ["moongame", "security"],
  "links": [
    {
      "title": "Обзор",
      "type": "link",
      "url": "/d/moongame-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Как читать этот экран",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Подозрение требует расследования и не доказывает атаку. Нет данных при просроченном источнике. Счётчики событий относятся к текущему процессу; журнал инцидентов сохраняется между обновлениями. Подробности: `moongame security incidents` и `moongame security events --request ID`. Внешние уведомления и автоматические санкции не включены."
      }
    },
    {
      "id": 2,
      "title": "Работоспособность детектора",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "moongame_security_detector_up and on (instance, environment) (time() - moongame_security_detector_sample_timestamp_seconds < 45)",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{rule}} {{event}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Возраст heartbeat аудита",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
