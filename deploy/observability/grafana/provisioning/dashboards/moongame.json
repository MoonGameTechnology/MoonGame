{
  "uid": "moongame-overview",
  "title": "MoonGame — обзор плейтеста",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "moongame",
    "playtest"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Свежесть сбора, секунд",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - moongame_observer_sample_timestamp_seconds",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 2,
      "title": "Источники игры: 1 — доступны",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(moongame_source_up) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Четыре источника: health, ready, metrics, summary. Ноль означает отказ источника; отсутствие данных — сбор не настроен или устарел."
    },
    {
      "id": 3,
      "title": "Готовность игры и БД",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(moongame_game_ready) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Нет данных при отсутствии или устаревании источника. Обновление каждые 15 секунд."
    },
    {
      "id": 4,
      "title": "Комнаты в реестре",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "moongame-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(moongame_matches) and on() (time() - moongame_observer_sample_timestamp_seconds < 45)",
          "instant": true,
          "legendFormat": "{{source}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
