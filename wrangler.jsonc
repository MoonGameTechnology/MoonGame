// Cloudflare Worker `moongame`: the web client as static assets — no Worker code.
// Workers Builds runs `npx wrangler deploy` on every push to `main` and `npx wrangler
// preview` on every other branch. Both build the site themselves through `build` below,
// so no build command is needed in the dashboard. Only the client lives here; the match
// server (Node + Postgres + WebSocket) is deployed from `deploy/`.
{
  "name": "moongame",
  "compatibility_date": "2026-09-25",
  // Wrangler runs this before it reads the assets directory, for `deploy` and `preview`
  // alike. The dashboard build command covers production builds only: preview builds
  // skipped it and failed on a missing `prototype/dist/site`.
  "build": {
    "command": "pnpm run site",
  },
  "assets": {
    // Staged by `scripts/stage-site.mjs`: only the player-facing pages of prototype/dist.
    "directory": "./prototype/dist/site",
  },
  // `npx wrangler preview` requires this block. Empty: previews do not inherit production
  // settings, and the site has no bindings or vars that a preview would need in their place.
  "previews": {},
}
